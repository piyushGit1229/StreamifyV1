# ==============================================================================
# STREAMIFY PRODUCTION-GRADE .GITIGNORE
# Covers Monorepo Root, Express Backend, Vite + React Frontend, and Cloud Hosts
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DEPENDENCIES & PACKAGE MANAGERS
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
backend/node_modules/
frontend/node_modules/
.pnp/
.pnp.js
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnpm-store/

# ------------------------------------------------------------------------------
# 2. ENVIRONMENT VARIABLES & SECRETS (STRICT SECURITY)
# ------------------------------------------------------------------------------
# Ignore all actual environment and local config files
.env
.env.*
*.env
*.env.*
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# CRITICAL: Always whitelist example/template env files
!.env.example
!*.env.example
!backend/.env.example
!frontend/.env.example

# ------------------------------------------------------------------------------
# 3. BUILD OUTPUTS & BUNDLER CACHES
# ------------------------------------------------------------------------------
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/
backend/dist/
build/
.vite/
frontend/.vite/
.cache/
backend/.cache/
frontend/.cache/
.eslintcache
.parcel-cache/
.turbo/

# ------------------------------------------------------------------------------
# 4. UPLOADS, MEDIA & RUNTIME STORAGE (NEVER COMMIT LARGE BINARIES)
# ------------------------------------------------------------------------------
# Ignore all uploaded videos, generated thumbnails, and temporary files
backend/src/uploads/*
!backend/src/uploads/.gitkeep
backend/src/uploads/temp/*
!backend/src/uploads/temp/.gitkeep
backend/backend/
uploads/
temp/
tmp/
backend/tmp/

# Media binaries safeguard
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.flv
*.wmv

# ------------------------------------------------------------------------------
# 5. LOGS & RUNTIME PROCESSES
# ------------------------------------------------------------------------------
logs/
backend/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pids
*.pid
*.seed
*.pid.lock
.pm2/
backend/.pm2/

# ------------------------------------------------------------------------------
# 6. LOCAL DATABASES & BACKUPS
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
backend/*.sqlite
backend/*.db
dump.rdb

# ------------------------------------------------------------------------------
# 7. OPERATING SYSTEM & IDE ARTIFACTS
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.suo
*.ntvs*
*.njsproj
*.sln

# Editors
.idea/
*.sublime-project
*.sublime-workspace
*.sw?
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
